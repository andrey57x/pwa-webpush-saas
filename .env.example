# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
APP_ENV=development
API_PORT=8080
WORKER_POOL_SIZE=10

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
MASTER_ENCRYPTION_KEY=32_bytes_long_secret_key_123456

# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=webpush_db
POSTGRES_SSLMODE=disable

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# APACHE KAFKA CONFIGURATION
# ==============================================================================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_UI_PORT=8081
KAFKA_TOPIC_PUSH_JOBS=push-jobs
KAFKA_CONSUMER_GROUP=push-workers-group
KAFKA_PARTITIONS=4

CONTACT_EMAIL=admin@bauman.ru